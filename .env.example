# Required: LAN address of the compatible Govee controller.
GOVEE_IP=

# Network settings.
GOVEE_PORT=4003
LISTEN_IP=0.0.0.0
LISTEN_PORT=19446

# Two bars with this many virtual RGB segments on each bar.
SEGMENTS_PER_BAR=10
FPS_LIMIT=15

# Physical orientation calibration.
SWAP_BARS=false
REVERSE_LEFT=false
REVERSE_RIGHT=false

# Adaptive temporal smoothing. Times are seconds to approximately 95% of target.
ADAPTIVE_SMOOTHING=true
BRIGHTNESS_ATTACK_SECONDS=0.15
BRIGHTNESS_RELEASE_SECONDS=0.35
COLOR_SETTLING_SECONDS=0.25

# Runtime behavior.
STATUS_INTERVAL=5
ARM_INTERVAL=40
TURN_OFF_ON_EXIT=true
